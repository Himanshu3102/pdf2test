# For production (Render/Neon), use Postgres:
# DATABASE_URL=postgresql+psycopg://user:pass@host/dbname?sslmode=require
DATABASE_URL=sqlite:///./data/exam_app.db
STORAGE_DIR=./data/uploads
MAX_UPLOAD_MB=25
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Auth: change this to a long random value in production
AUTH_SECRET_KEY=dev-secret-change-me-in-production
AUTH_TOKEN_TTL_DAYS=30

# Google Gemini (OpenAI-compatible) - preferred if set
GEMINI_API_KEY=
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
GEMINI_MODEL=gemini-3.1-flash-lite
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# OpenCode Go (OpenAI-compatible) - preferred if set
OPENCODE_GO_API_KEY=
OPENCODE_GO_BASE_URL=https://opencode.ai/zen/go/v1
OPENCODE_GO_MODEL=
LLM_TIMEOUT_SECONDS=60
OCR_ENABLED=true
OCR_DPI=150
VISION_ENABLED=true

# Cloudflare R2 / S3-compatible object storage (optional; falls back to local disk)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_ENDPOINT_URL=
